# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file and never share it or screenshot it.

# OpenWeatherMap API key
WEATHER_API_KEY=

# Email sending (use a Gmail App Password, NOT your normal Gmail password)
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Optional - these defaults work for Gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
